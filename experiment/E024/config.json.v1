{
  "experiment": "E024",
  "title": "Exogenous predictors for the agricultural panel (Gate A audit round)",
  "targets": {
    "wheat": "^barchart cash soft red wheat index$",
    "corn": "^barchart cash national corn index$",
    "soybean": "^barchart cash national soybean index$",
    "rice": "rice.*price",
    "coffee_r": "cepea/esalq robusta",
    "sugar": "white sugar price index"
  },
  "exog": {
    "oni": "oceanic nino index",
    "soi": "southern oscillation index",
    "rain": "houston.*precipitation",
    "brl": "u\\.s\\. dollar / brazilian real",
    "dollar": "nominal advanced foreign economies dollar index",
    "crude": "cushing wti spot price",
    "bdi": "^baltic dry index$",
    "fertilizer": "fertilizer.*price",
    "corn_basis": "u\\.s\\. corn basis index$"
  },
  "directions": [
    {
      "name": "adl_parity_fx",
