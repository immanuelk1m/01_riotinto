      "model": "adl",
      "targets": [
        "corn",
        "soybean",
        "wheat",
        "rice"
      ],
      "exog": [
        "rain",
        "crude"
      ]
    },
    {
      "name": "lasso_agri",
      "model": "lasso",
      "targets": [
        "corn",
        "soybean",
        "wheat",
        "coffee_r",
        "cocoa",
        "sugar"
      ],
      "exog": [
        "oni",
